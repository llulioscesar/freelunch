# Database
DATABASE_URL="postgresql://user:password@host:port/database?schema=orders"

# Redis Configuration (Upstash)
# Used for: Caching + Event Streaming (Pub/Sub)
REDIS_URL="https://your-redis-instance.upstash.io"
REDIS_TOKEN="your_redis_token"
# Alternative names (if using Upstash directly)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token"

# Service URLs
KITCHEN_SERVICE_URL="https://freelunch-kitchen.vercel.app"
WAREHOUSE_SERVICE_URL="https://freelunch-warehouse.vercel.app"
MARKET_SERVICE_URL="https://freelunch-market.vercel.app"

# Service Configuration
SERVICE_NAME="orders-service"
NODE_ENV="production"
PORT=3001