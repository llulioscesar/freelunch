# ==============================================
# REQUIRED VARIABLES
# ==============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database?schema=orders"

# Redis Configuration (Upstash Redis)
# Used for: Caching and repository optimization
REDIS_URL="https://your-redis-instance.upstash.io"
REDIS_TOKEN="your_redis_token_here"
# Alternative Upstash variable names (use either REDIS_* or UPSTASH_REDIS_*)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token_here"

# QStash Configuration (Upstash QStash)
# Used for: Event publishing and async messaging
QSTASH_TOKEN="your_qstash_token_here"

# Kitchen Service
# Required for order processing workflow
KITCHEN_SERVICE_URL="https://your-kitchen-service.vercel.app"

# ==============================================
# OPTIONAL VARIABLES
# ==============================================

# Warehouse Service (optional - for inventory management)
WAREHOUSE_SERVICE_URL="https://your-warehouse-service.vercel.app"

# Market Service (optional - for product catalog)
MARKET_SERVICE_URL="https://your-market-service.vercel.app"

# Service Configuration
SERVICE_NAME="orders-service"
NODE_ENV="development"  # development | production | test

# Logging
LOG_LEVEL="info"  # trace | debug | info | warn | error | fatal