# ==============================================
# REQUIRED VARIABLES
# ==============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database?schema=orders"

# Redis Configuration (Upstash Redis REST API)
# Used for: Caching, repository optimization, and Redis Streams for event messaging
# Get these from: https://console.upstash.com/redis -> Your Database -> REST API tab
REDIS_URL="https://your-redis-instance.upstash.io"
REDIS_TOKEN="your_redis_rest_token_here"

# Alternative Upstash variable names (use either REDIS_* or UPSTASH_REDIS_*)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_rest_token_here"

# ==============================================
# OPTIONAL VARIABLES
# ==============================================

# Service Configuration
SERVICE_NAME="orders-service"
NODE_ENV="development"  # development | production | test

# Logging
LOG_LEVEL="info"  # trace | debug | info | warn | error | fatal

# ==============================================
# NOTES
# ==============================================
# - Event messaging uses Redis Streams (not QStash or HTTP)
# - Other services (kitchen, warehouse) consume events from Redis Streams
# - No service URLs needed - all communication via Redis Streams