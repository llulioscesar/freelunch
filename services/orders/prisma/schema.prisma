// Prisma Schema for Orders Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String    @id
  quantity     Int
  customerName String    @default("Anonymous")
  notes        String?
  status       String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}