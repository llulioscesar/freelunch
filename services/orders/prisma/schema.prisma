// Prisma Schema for Orders Service

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String      @id
  quantity     Int
  customerName String      @default("Anonymous")
  notes        String?
  status       String
  createdAt    DateTime    @default(now())
  completedAt  DateTime?
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String    @id
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipeId       String?
  recipeName     String?
  status         String    @default("PENDING")

  createdAt      DateTime  @default(now())
  assignedAt     DateTime?
  preparedAt     DateTime?
  deliveredAt    DateTime?
  failureReason  String?

  statusHistory  OrderItemStatusHistory[]

  @@index([orderId])
  @@index([status])
}

// Status history for complete traceability
model OrderItemStatusHistory {
  id          String   @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  fromStatus  String?  // null for initial state
  toStatus    String
  changedAt   DateTime @default(now())

  // Additional context
  recipeId    String?
  recipeName  String?
  reason      String?  // For failures or notes
  metadata    Json?    // Any extra data

  @@index([orderItemId])
  @@index([changedAt])
}