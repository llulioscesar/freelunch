{
  "name": "orders-service",
  "version": "1.0.0",
  "private": true,
  "description": "Orders management service for FreeLunch system",
  "scripts": {
    "dev": "vercel dev --listen 3001",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "deploy": "vercel --prod",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "worker:kitchen": "node dist/workers/kitchen-consumer.js",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@upstash/qstash": "^2.2.0",
    "@upstash/redis": "^1.28.0",
    "@vercel/kv": "^1.0.1",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vercel/node": "^3.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "typescript": "^5.3.3"
  }
}
