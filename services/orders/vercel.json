{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "api/workers/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/presentation/api"
    },
    {
      "source": "/(.*)",
      "destination": "/src/presentation/api/$1"
    }
  ],
  "env": {
    "SERVICE_NAME": "orders-service"
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "test": true
    }
  }
}