{
  "name": "@freelunch/kitchen",
  "version": "0.0.1",
  "type": "module",
  "description": "Kitchen Service - Manages recipe assignment and plate preparation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vercel dev --listen 3002",
    "build": "prisma generate && node scripts/postgenerate.js && tsc && tsc-alias && node scripts/add-js-extensions.js && node scripts/postbuild.js",
    "vercel-build": "prisma generate && node scripts/postgenerate.js && tsc && tsc-alias && node scripts/add-js-extensions.js && node scripts/postbuild.js",
    "pretest": "prisma generate && node scripts/postgenerate.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "jest --testPathPattern=__tests__/e2e",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "postgenerate": "node scripts/postgenerate.js",
    "prisma:generate": "prisma generate && node scripts/postgenerate.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "kitchen",
    "recipes",
    "plates",
    "hexagonal-architecture",
    "ddd"
  ],
  "author": "StartCodex",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@upstash/redis": "^1.34.3",
    "@vercel/node": "^5.5.10",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.15.6",
    "@types/pino": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jiti": "^2.6.1",
    "prisma": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
