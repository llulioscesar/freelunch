// Prisma Schema for Kitchen Service

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Recipe entity - 6 recipes available for random selection
model Recipe {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  ingredients Json     // { "tomato": 2, "cheese": 1, "meat": 1 }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plates      Plate[]

  @@index([name])
}

// Plate entity - Individual dish being prepared
model Plate {
  id            String    @id @default(cuid())

  // Reference to Orders service (external)
  orderId       String
  orderItemId   String

  // Recipe assignment
  recipeId      String?
  recipe        Recipe?   @relation(fields: [recipeId], references: [id])
  recipeName    String?
  ingredients   Json?     // Required ingredients with quantities

  // Status tracking
  status        String    @default("PENDING")

  // Timestamps
  createdAt     DateTime  @default(now())
  assignedAt    DateTime?
  cookingAt     DateTime?
  readyAt       DateTime?
  updatedAt     DateTime  @updatedAt

  // Failure tracking
  failureReason String?
  retryCount    Int       @default(0)

  statusHistory PlateStatusHistory[]

  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
  @@index([createdAt])
  @@unique([orderItemId])
}

// Status history for complete traceability
model PlateStatusHistory {
  id        String   @id @default(cuid())
  plateId   String
  plate     Plate    @relation(fields: [plateId], references: [id], onDelete: Cascade)

  fromStatus  String?  // null for initial state
  toStatus    String
  changedAt   DateTime @default(now())

  // Additional context
  recipeId    String?
  recipeName  String?
  reason      String?  // For failures or notes
  metadata    Json?    // Any extra data (ingredients, etc)

  @@index([plateId])
  @@index([changedAt])
}
