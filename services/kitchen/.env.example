# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kitchen_db?schema=public"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Event Streams
ORDERS_STREAM_NAME="orders:events"
KITCHEN_STREAM_NAME="kitchen:events"
KITCHEN_CONSUMER_GROUP="kitchen-service"

# Warehouse Service
WAREHOUSE_SERVICE_URL="https://your-warehouse-service.vercel.app"

# Environment
NODE_ENV="development"
LOG_LEVEL="debug"
