# Database (Prisma v7 - configured via prisma.config.ts)
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kitchen_db?schema=public"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Event Streams (Redis Streams)
ORDERS_EVENTS_STREAM="stream:orders:events"
KITCHEN_EVENTS_STREAM="stream:kitchen:events"
KITCHEN_CONSUMER_GROUP="kitchen-service"

# Warehouse Communication (Redis Streams - not HTTP!)
WAREHOUSE_REQUESTS_STREAM="stream:warehouse:requests"
WAREHOUSE_RESPONSES_STREAM="stream:warehouse:responses"
WAREHOUSE_CONSUMER_GROUP="warehouse-service"

# Environment
NODE_ENV="development"
LOG_LEVEL="debug"
